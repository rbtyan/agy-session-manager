#!/usr/bin/env bash
set -euo pipefail

# Resolve real directory even when invoked via symlink (e.g. ~/.local/bin/agym)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
APP_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

VENV_PY="$APP_DIR/.venv/bin/python"
TMUX_CONF="$APP_DIR/tmux.conf"
TMUX_SOCKET="agym"
TMUX_SESSION="main"
LAUNCH_CWD="$(pwd)"

if [ ! -x "$VENV_PY" ]; then
  echo "Error: virtualenv not found at $VENV_PY" >&2
  echo "Please run: $APP_DIR/install.sh" >&2
  exit 1
fi

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
agym - AGY Session Manager

Usage:
  agym              Open (or re-attach to) the interactive Session Manager TUI
  agym -l, --list   List recent AGY sessions in plain text
  agym kill         Stop the background agym tmux server and all managed sessions
  agym -h, --help   Show this help

Shortcuts inside an agy session:
  ← ← (double-tap)  Return to Session Manager
  Alt+← / Ctrl+←    Return to Session Manager (instant)

Shortcuts inside Session Manager:
  Enter             Open / resume / switch to selected session
  Space             Toggle multi-select on highlighted session
  a                 Select all / clear selection
  d / Delete        Delete highlighted (or multi-selected): press d again to confirm, Esc to cancel
  n                 Launch a new agy session
  k                 Close an active background session window
  r                 Rename session (custom display label)
  p                 Pin / unpin session
  /                 Search sessions (title, workspace, and FTS5 full-text)
  Tab               Toggle All Workspaces / Current Workspace
  q                 Exit prompt: q = detach (keep running), k = close all & exit, Esc = cancel
EOF
    exit 0
    ;;
  -l|--list)
    "$VENV_PY" -c "
import sys; sys.path.insert(0, sys.argv[1])
import data
for s in data.fetch_sessions(limit=25):
    st = s.state_kind.upper().ljust(11)
    rel = data.format_relative_time(s.last_modified_ts).rjust(7)
    print(f'{s.conversation_id[:8]}  {st}  {rel}  {s.display_title}  [{data.shorten_path(s.workspace_path, 35)}]')
" "$APP_DIR"
    exit 0
    ;;
  kill|kill-server)
    env -u TMUX tmux -L "$TMUX_SOCKET" kill-server 2>/dev/null || true
    echo "Stopped agym server."
    exit 0
    ;;
esac

# Start dedicated tmux server with Session Manager in window 0 if not running
if ! env -u TMUX tmux -L "$TMUX_SOCKET" has-session -t "$TMUX_SESSION" 2>/dev/null; then
  env -u TMUX AGYM_APP_DIR="$APP_DIR" tmux -L "$TMUX_SOCKET" -f "$TMUX_CONF" new-session -d -s "$TMUX_SESSION" -n manager \
    "AGYM_LAUNCH_CWD=$(printf '%q' "$LAUNCH_CWD") $(printf '%q' "$VENV_PY") $(printf '%q' "$APP_DIR/tui.py")"
  env -u TMUX tmux -L "$TMUX_SOCKET" set-environment -g AGYM_APP_DIR "$APP_DIR"
  env -u TMUX tmux -L "$TMUX_SOCKET" set-option -g @agym_launch_cwd "$LAUNCH_CWD"
else
  env -u TMUX tmux -L "$TMUX_SOCKET" set-environment -g AGYM_APP_DIR "$APP_DIR"
  env -u TMUX tmux -L "$TMUX_SOCKET" set-option -g @agym_launch_cwd "$LAUNCH_CWD"
  env -u TMUX tmux -L "$TMUX_SOCKET" select-window -t "$TMUX_SESSION:manager" 2>/dev/null || true
fi

exec env -u TMUX tmux -L "$TMUX_SOCKET" attach-session -t "$TMUX_SESSION"
